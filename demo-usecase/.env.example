# Local development only. Constraint 6: no secrets in source, images, config files or
# commits. This file is the template; `make env` generates .env with random local
# passwords, and .env is gitignored.
POSTGRES_DB=mopay
POSTGRES_USER=mopay_owner
POSTGRES_PASSWORD=replace-me
APP_DB_USER=mopay_app
APP_DB_PASSWORD=replace-me

# Read by merchant-api only; the mopay services take their environment from the
# platform's labels, not from a variable of their own.
ENVIRONMENT=dev
DATA_REGION=KE
LOG_LEVEL=info

# Settlement behaviour. Nothing here is baked into an image (constraint 5).
RUN_MODE=interval
RUN_INTERVAL=2m
SETTLEMENT_PERIOD_HOURS=24
RUN_WINDOW=2h
FORCE_MONTH_END=false

# C-5.2 / S-3.4. 26h in production; shorten these to demo the banner and the alert.
SETTLEMENT_STALENESS_THRESHOLD=26h
SETTLEMENT_LAG_ALERT_THRESHOLD=26h
LAG_REFRESH_INTERVAL=15s

# Published host ports
COLLECTIONS_PUBLISH_PORT=8088
CONSOLE_PUBLISH_PORT=5173
POSTGRES_PUBLISH_PORT=55432

# Browser origins allowed to call collections-api (the console is a separate origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Injected into the console at container start (not baked into the image). Browser
# addresses, not in-network ones.
CONSOLE_API_BASE_URL=http://localhost:8088
CONSOLE_MERCHANT_API_BASE_URL=http://localhost:8092
